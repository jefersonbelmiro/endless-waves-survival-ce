valign = 1

[node name="selected_tween" type="Tween" parent="."]
repeat = true
playback/repeat = true

[node name="pressed_tween" type="Tween" parent="."]

[connection signal="button_down" from="." to="." method="_on_book_button_button_down"]
[connection signal="button_up" from="." to="." method="_on_book_button_button_up"]
