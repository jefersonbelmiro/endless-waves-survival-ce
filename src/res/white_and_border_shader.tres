[gd_resource type="Shader" format=2]

[resource]
code = "shader_type canvas_item;

// sprite options
uniform bool add_color = false;
uniform vec4 color: hint_color = vec4(1.0);
uniform float color_modifier: hint_range(0, 1) = 1.0;

// border options
uniform bool add_border = false;
uniform vec4 border_color : hint_color = vec4(1.0);
uniform float border_width : hint_range(0, 10) = 1.0;
uniform int border_pattern : hint_range(0, 2) = 0; // diamond, circle, square
uniform bool border_inside = false;
uniform bool border_add_margins = true; // only useful when border_inside is false

void vertex() {
	if (add_border && border_add_margins) {
		VERTEX += (UV * 2.0 - 1.0) * border_width;
	}
}

bool hasContraryNeighbour(vec2 uv, vec2 texture_pixel_size, sampler2D texture) {
	for (float i = -ceil(border_width); i <= ceil(border_width); i++) {
		float x = abs(i) > border_width ? border_width * sign(i) : i;
		float offset;
		
		if (border_pattern == 0) {
			offset = border_width - abs(x);
		} else if (border_pattern == 1) {
			offset = floor(sqrt(pow(border_width + 0.5, 2) - x * x));
		} else if (border_pattern == 2) {
			offset = border_width;
		}
		
		for (float j = -ceil(offset); j <= ceil(offset); j++) {
			float y = abs(j) > offset ? offset * sign(j) : j;
			vec2 xy = uv + texture_pixel_size * vec2(x, y);
			
			if ((xy != clamp(xy, vec2(0.0), vec2(1.0)) || texture(texture, xy).a == 0.0) == border_inside) {
				return true;
			}
		}
	}
	
	return false;
}

void fragment() {
	vec2 uv = UV;
	
	if (add_border && border_add_margins) {
		vec2 texture_pixel_size = vec2(1.0) / (vec2(1.0) / TEXTURE_PIXEL_SIZE + vec2(border_width * 2.0));
		
		uv = (uv - texture_pixel_size * border_width) * TEXTURE_PIXEL_SIZE / texture_pixel_size;
		
		if (uv != clamp(uv, vec2(0.0), vec2(1.0))) {
			COLOR.a = 0.0;
		} else {
			COLOR = texture(TEXTURE, uv);
		}
	} else {
		COLOR = texture(TEXTURE, uv);
	}
	if (add_color) {
		COLOR = vec4(mix(COLOR.rgb, color.rgb, color_modifier), COLOR.a);
	}
	if (add_border && (COLOR.a > 0.0) == border_inside && hasContraryNeighbour(uv, TEXTURE_PIXEL_SIZE, TEXTURE)) {
		COLOR.rgb = border_inside ? mix(COLOR.rgb, border_color.rgb, border_color.a) : border_color.rgb;
		COLOR.a += (1.0 - COLOR.a) * border_color.a;
	}

}"
