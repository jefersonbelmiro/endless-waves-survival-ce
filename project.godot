[application]

config/name="Endless waves survival"
run/main_scene="res://src/screens/menu/menu_screen.tscn"
config/icon="res://publish/store/icons/icon_64x64.png"

[autoload]

Settings="*res://src/autoload/settings.gd"
Global="*res://src/autoload/global.gd"
Database="*res://src/autoload/database.gd"
Entities="*res://src/autoload/entities.gd"
Persistent="*res://src/autoload/persistent.gd"
SFX="*res://src/autoload/sfx.gd"
InputSource="*res://src/autoload/input_source.gd"
DataFormatter="*res://src/autoload/data_formatter.gd"
Targets="*res://src/autoload/targets.gd"
Traits="*res://src/autoload/traits.gd"
Firebase="*res://src/autoload/firebase.gd"
Steam="*res://addons/steam_api/steam_i.gd"

[debug]

gdscript/warnings/unused_signal=false
gdscript/warnings/return_value_discarded=false

[display]

window/size/width=480
window/size/height=260
window/size/test_width=1280
window/size/test_height=720
window/handheld/orientation="sensor_landscape"
window/stretch/mode="2d"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PoolStringArray( "res://addons/steam_api/plugin.cfg" )

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d": false,
"flags/anisotropic": false,
"flags/filter": false,
"flags/mipmaps": false,
"flags/repeat": 0,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}

[input]

ui_accept={
"deadzone": 0.5,
