[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="env"
2d_physics/layer_3="enemy"
2d_physics/layer_4="spell"
2d_physics/layer_5="drop"
2d_physics/layer_6="player_hurtbox"
2d_physics/layer_7="enemy_hurtbox"
2d_physics/layer_8="ghost"
2d_physics/layer_9="map_bounds"
2d_physics/layer_10="fly"
2d_physics/layer_11="npc"
2d_physics/layer_12="abysm"
2d_physics/layer_13="boss"
2d_physics/layer_14="summon"
2d_physics/layer_15="player_dashing"

[locale]

translations=PoolStringArray( "res://src/i18n/localization.en.translation", "res://src/i18n/localization.pt.translation", "res://src/i18n/localization.zh.translation" )
locale_filter=[ 0, [  ] ]

[node]

name_num_separator=2
name_casing=2

[physics]

common/enable_pause_aware_picking=true

[rendering]

2d/snapping/use_gpu_pixel_snap=true
environment/default_environment="res://default_env.tres"
